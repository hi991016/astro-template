---
// ===== PROPS =====
interface Props {
  title: string
  description?: string
  ogImage?: string
  lang?: string
  ogLocale?: string
  ogType?: string
  ogSiteName?: string
  typekitId?: string
}

const {
  title,
  description = '',
  ogImage = '',
  lang = 'ja',
  ogLocale = 'ja_JP',
  ogType = 'website',
  ogSiteName = '',
  typekitId = 'KID_ID_HERE'
} = Astro.props

const hasTypekit = typekitId && typekitId !== 'KID_ID_HERE'
const siteNameResolved = ogSiteName || title
// -- the url the page is built at ("/about/"): stripping the slash would point at a redirect
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : ''
const page = Astro.url.pathname === '/' ? 'home' : Astro.url.pathname.replace(/\//g, '')

// ===== IMPORTS =====
import '@/styles/style.scss'

import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import Typekit from '@/components/Typekit.astro'
import { ClientRouter } from 'astro:transitions'
import { TRANSITION, transition } from '@/transitions'

// ===== PAGE TRANSITION =====
// -- the whole page is the "root" view transition, animated as set in src/transitions/index.ts
const TransitionMarkup = transition.markup
---

<!doctype html>
<html
  lang={lang}
  data-transition={TRANSITION}
  transition:name="root"
  transition:animate={transition.animate}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- @meta -->
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteNameResolved} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" />

    <!-- @adobe fonts -->
    {hasTypekit && <Typekit typekitId={typekitId} />}

    <!-- @astro transition -->
    <ClientRouter fallback="none" />
  </head>

  <body data-page={page}>
    <!-- @header -->
    <Header />
    <!-- @@header -->

    <!-- @main -->
    <slot />
    <!-- @@main -->

    <!-- @footer -->
    <Footer />
    <!-- @@footer -->

    <!-- @page transtion -->
    {TransitionMarkup && <TransitionMarkup />}
    <!-- @@page transition -->

    <!-- @custom scrollbar -->
    <div class="c-scrollbar" data-scrollbar transition:persist="scrollbar">
      <div class="c-scrollbar_thumb" data-scrollbar-thumb></div>
    </div>
    <!-- @@custom scrollbar -->

    <!-- @script -->
    <script>
      import '@/app.js'
    </script>
  </body>
</html>
